# Скопируй в .env и впиши свои значения

# 1 — режим разработки, 0 — прод (тогда DJANGO_SECRET_KEY обязателен)
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
# Через запятую, например: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Ключ из Google AI Studio — нужен только для кнопки «Сгенерировать КП»
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
